generator client {
  provider = "prisma-client-js"
}

// Local development uses SQLite. For hosted Postgres, change provider to
// "postgresql" and point DATABASE_URL at your database. The models themselves
// stay the same.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  readings     Reading[]
}

model Reading {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         String   @default("")
  spreadId         String
  locale           String   @default("zh")
  cardsJson        String
  summary          String
  aiInterpretation String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
