generator client {
  provider      = "prisma-client-js"
  // Vercel builds and runs on Amazon Linux. `native` covers the machine that
  // runs `prisma generate`; the rhel target is the serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  readings     Reading[]
}

model Reading {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         String   @default("")
  spreadId         String
  locale           String   @default("zh")
  cardsJson        String
  summary          String
  aiInterpretation String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
