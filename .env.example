# SQLite file used by Prisma locally. The path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Required in production. Any long random string. Used to sign the session cookie.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. When set, readings can request a personalized AI interpretation.
# When unset, the app still builds a full summary from the card meanings.
OPENAI_API_KEY=""
# Optional override for OpenAI-compatible gateways.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Public site URL used for sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:4178"
