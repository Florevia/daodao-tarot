# Local Postgres from `docker compose up -d`. Use the direct (non-pooled)
# connection string in production. See the README deployment section.
DATABASE_URL="postgresql://daodao:daodao@127.0.0.1:5432/daodao"

# Required in production. Any long random string. Used to sign the session cookie.
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. When either name is set, readings can request a Gemini interpretation.
# When both are unset, the app still builds a full summary from the card meanings.
GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
# Optional model override. Defaults to gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"

# Optional. When set, readings use ZenMux instead of Gemini.
# ZenMux is OpenAI-compatible: https://zenmux.ai/api/v1/chat/completions
# ZENMUX_API_KEY=""
# ZENMUX_MODEL="anthropic/claude-haiku-5.5"
# Force one provider when both keys exist: gemini or zenmux.
# AI_PROVIDER=""

# Public site URL used for sitemap, canonical, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:4178"

# Comma-separated emails that can open /admin. Everyone else gets a 404.
# ADMIN_EMAILS="you@example.com"

# AI readings per IP+device per Pacific day, and the site-wide daily cap.
# AI_DAILY_LIMIT="10"
# AI_SITE_DAILY_CAP="90"

# Login and register attempts per IP and per email in 15 minutes.
# AUTH_ATTEMPT_LIMIT="10"

# Saved-reading writes per account per hour, and how many readings an account keeps.
# READING_WRITE_LIMIT="30"
# READING_KEEP="500"

# Gemini spend is recorded as $0 unless this is 0. The paid-price estimate is always stored.
# GEMINI_FREE_TIER="1"
