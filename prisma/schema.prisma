generator client {
  provider      = "prisma-client-js"
  // Vercel builds and runs on Amazon Linux. `native` covers the machine that
  // runs `prisma generate`; the rhel target is the serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  readings     Reading[]
}

model Reading {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         String   @default("")
  spreadId         String
  locale           String   @default("zh")
  cardsJson        String
  summary          String
  contextJson      String   @default("{}")
  aiInterpretation String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model RateBucket {
  id        String   @id @default(cuid())
  bucket    String
  windowKey String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([bucket, windowKey])
  @@index([updatedAt])
}

model ModelQuota {
  model          String   @id
  exhaustedUntil DateTime
  updatedAt      DateTime @updatedAt
}

model BudgetTopUp {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  amountUsd  Float
  note       String   @default("")
  adminEmail String
}

model InterpretLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  userId       String?
  userEmail    String?
  guestKey     String?
  question     String
  spreadId     String
  contextJson  String   @default("{}")
  cardsJson    String
  readingJson  String?
  provider     String?
  modelUsed    String?
  modelsTried  String   @default("[]")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  latencyMs    Int      @default(0)
  outcome      String
  errorReason  String?
  costUsd      Float    @default(0)
  wouldCostUsd Float    @default(0)
  freeTier     Boolean  @default(false)

  @@index([createdAt])
  @@index([outcome])
  @@index([userId])
  @@index([spreadId])
  @@index([modelUsed])
}
